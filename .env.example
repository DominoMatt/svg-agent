# llm-agent environment configuration
# Copy to .env and adjust as needed.

# Port for the local playground server (serves the UI + proxies to the model).
PORT=5173

# Ollama server the proxy relays to.
OLLAMA_BASE=http://127.0.0.1:11434

# Optional: a downstream service (e.g. an SVG studio on :3000) the UI may
# eventually speak to. Reserved for a future connector — unused today.
STUDIO_BASE=http://127.0.0.1:3000