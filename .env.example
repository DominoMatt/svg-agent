# svg-agent environment configuration
# Copy to .env and adjust as needed

# Path to the GGUF model file for the embedded LLM backend
# Default: models/qwen2.5-0.5b-instruct-q4_k_m.gguf
# SVG_MODEL_PATH=/absolute/path/to/your/model.gguf

# For Ollama backend (future use):
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5-coder:3b